# =====================================================================
#  INVOICE REMINDER - YOUR SETTINGS
#  Change the words after each = sign. Then save (Ctrl+S) and close.
#  Lines that start with # are notes, and the tool ignores them.
# =====================================================================

# --- Your shop (this appears at the bottom of every reminder) --------
SHOP_NAME=Your Shop Name
SHOP_PHONE=07XX XXX XXX
SHOP_EMAIL=you@example.com
SIGNED_BY=Accounts Office

# --- How customers pay you --------------------------------------------
# Fill in the ones you use and leave the rest empty.
# Paybill: the invoice number is used as the account number.
MPESA_PAYBILL=
MPESA_TILL=
BANK_DETAILS=

# --- Where your invoices are -------------------------------------------
# The Excel sheet with your credit sales. Just the name if it is in this
# folder, or the full path, e.g.  C:/Users/Shop/Documents/invoices.xlsx
INVOICE_FILE=invoices.xlsx
# Where the ready-to-send reminders are saved.
OUTBOX_FOLDER=Outbox

# --- When to check -----------------------------------------------------
# Every day at this time (24-hour clock: 07:30 = 7:30 am, 18:00 = 6 pm).
CHECK_TIME=07:30

# --- Optional: email me the list every morning -------------------------
# yes = send the owner an email with who owes what and today's reminders.
# Needs a Gmail address and a Gmail "App Password" (16 letters), from
# myaccount.google.com > Security > App passwords. Not your normal password.
EMAIL_ME_THE_LIST=no
GMAIL_ADDRESS=yourshop@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Who gets the email (several: separate with commas). Empty = GMAIL_ADDRESS.
NOTIFY_TO=
